{
  "shape": { "borderRadius": 8 },
  "typography": {
    "fontFamily": "Inter, system-ui, sans-serif",
    "h4": { "fontWeight": 600 }
  },
  "colorSchemes": {
    "light": {
      "palette": {
        "primary": { "main": "#1565c0" },
        "warning": { "main": "#ed6c02", "light": "#fff4e5" },
        "success": { "main": "#2e7d32", "light": "#edf7ed" },
        "error": { "main": "#c62828", "light": "#fdecea" },
        "background": { "default": "#ffffff", "paper": "#f5f5f5" },
        "text": { "primary": "#1a1a1a", "secondary": "#5f6368" }
      }
    },
    "dark": {
      "palette": {
        "primary": { "main": "#90caf9" },
        "warning": { "main": "#ffb74d", "light": "#3a2a12" },
        "success": { "main": "#81c784", "light": "#1e2f1e" },
        "error": { "main": "#ef9a9a", "light": "#3a1f1f" },
        "background": { "default": "#121212", "paper": "#1e1e1e" },
        "text": { "primary": "#ffffff", "secondary": "#b0b3b8" }
      }
    }
  }
}
